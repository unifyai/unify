# assets/ holds local screenshots by default; allow-list specific repo-shipped
# diagrams below. (Use 'assets/*' rather than 'assets/' so the exceptions take
# effect — git can't un-ignore a file inside a fully-ignored directory.)
assets/*
discord_messages.md
.cursor/debug.log
/.cursor/projects/
/.cursor/plans/
# Per-run parse/ingest progress events. The reporter auto-generates these
# relative to the working directory when no path is configured, so a test run
# started from the repo root drops them here.
pipeline_progress_*.jsonl
# Ignore log contents but keep the README and utility scripts
logs/*
!logs/README.md
.repairs_queries/
# Legacy rename leftovers (never re-track)
droid/
.cache.ndjson.idx
# Brand assets referenced by the README are tracked.
!assets/brand/
